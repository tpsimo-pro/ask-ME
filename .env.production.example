# Production environment variables for Railway.
#
# This is a REFERENCE, not a file you copy into the repo or load with
# --env-file. Railway does not read .env files from the repo at all — you
# paste each variable into the service's "Variables" tab in the dashboard.
# This file only documents which values differ from .env.example (local
# dev) and why. See DEPLOY.md for the step-by-step dashboard walkthrough.
#
# Only variables that change for production are listed. Anything not
# listed here (GROQ_API_KEY, GROQ_MODEL, JWT_SECRET, JWT_EXPIRE_MINUTES,
# REFRESH_TOKEN_EXPIRE_DAYS, RESET_TOKEN_EXPIRE_MINUTES, EMAIL_FROM,
# SMTP_*) keeps the same meaning as in .env.example — just set them with
# real production values (real SMTP creds, a freshly generated JWT_SECRET,
# etc).

# --- Backend service ---

# Required outside development: boot fails without a real SMTP_HOST once
# ENVIRONMENT != "development" (see backend/app/core/config.py).
ENVIRONMENT=production

# Required in production: without this the browser will not reliably send
# the refresh-token cookie back over HTTPS. See README's
# "Restrição de deploy para o cookie de refresh" section.
COOKIE_SECURE=true

# Railway terminates TLS at its edge proxy and proxies every request to
# your container from Railway's internal network, so request.client.host
# is Railway's proxy IP for every visitor, not the real client. The
# per-IP login/register/forgot-password rate limiters
# (backend/app/core/rate_limit.py:client_ip) need X-Forwarded-For to tell
# visitors apart; without this, every visitor shares one rate-limit bucket
# behind Railway's proxy. Set true for the backend service on Railway.
TRUST_PROXY_HEADERS=true

# Point at the deployed backend's own public domain + callback path (the
# Google Cloud Console OAuth client's "Authorized redirect URI" must match
# this exactly).
GOOGLE_REDIRECT_URI=https://<your-backend>.up.railway.app/auth/google/callback

# Point at the deployed frontend's public domain. Used for CORS
# (allow_origins) and as the post-login OAuth redirect target.
FRONTEND_URL=https://<your-frontend>.up.railway.app

# Leave this as Railway's reference variable, do not hardcode a value.
# When you add the Postgres plugin to the project, Railway exposes
# ${{Postgres.DATABASE_URL}} — set the backend's DATABASE_URL variable to
# that reference in the dashboard and Railway substitutes the real,
# private connection string at deploy time.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- Frontend service ---

# Point the SPA's API calls at the deployed backend's public domain.
# This is a build-time Vite variable: it gets baked into the static
# bundle, so it must be set on the frontend service BEFORE the build
# runs (Railway does this automatically since it rebuilds on every
# deploy/variable change).
VITE_API_BASE_URL=https://<your-backend>.up.railway.app

# --- Known limitation: cross-site refresh cookie ---
#
# The refresh-token cookie is set with SameSite=Lax (hardcoded, see
# backend/app/auth/refresh_tokens.py). SameSite=Lax cookies are only sent
# on fetch/XHR requests when frontend and backend are "same-site" (same
# registrable domain). Railway's default *.up.railway.app domains are
# each their own site (up.railway.app is on the Public Suffix List), so
# a fetch from the frontend's .up.railway.app domain to the backend's
# .up.railway.app domain will NOT include the refresh cookie.
#
# Effect: login works, but the session will not survive past the access
# token's lifetime (JWT_EXPIRE_MINUTES, default 15 min) — the user gets
# logged out and must log in again instead of transparently refreshing.
# Nothing is broken or insecure, it's just a UX downgrade versus same-site
# deployment.
#
# Fix (optional, requires owning a domain): put both services on custom
# subdomains of the SAME apex domain, e.g. app.yourdomain.com (frontend)
# and api.yourdomain.com (backend). Subdomains of one registrable domain
# are "same-site", so SameSite=Lax works exactly as in local dev. Railway
# supports custom domains per service for free (Settings > Networking >
# Custom Domain), you just need a domain and a CNAME record.
#
# If you don't have a spare domain for a portfolio demo, the default
# *.up.railway.app domains are fine to ship with — just know that a
# visitor's session will need re-login after ~15 minutes.
